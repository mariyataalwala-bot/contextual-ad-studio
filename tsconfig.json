{
 "compilerOptions": {
  "target": "es2023",
  "module": "nodenext",
  "moduleResolution": "nodenext",
  "lib": ["es2023", "dom", "dom.iterable"],
  "types": ["node"],
  "allowJs": true,
  "checkJs": true,
  "noEmit": true,
  "strict": false,
  "noImplicitThis": true,
  "noFallthroughCasesInSwitch": true,
  "skipLibCheck": true,
  "resolveJsonModule": true
 },
 "include": ["openweb/**/*.mjs", "test/**/*.mjs"]
}
